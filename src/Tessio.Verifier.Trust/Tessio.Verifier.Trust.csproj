<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- The resolved package graph, transitive packages included, is committed as packages.lock.json
         beside this file, inside src/, so the conformance record's src tree covers it. CI restores in
         locked mode, so a bump that did not regenerate the lock file fails. It guards against
         accidents, not deliberate edits; see tools/check-conformance-record.py. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- For MessageText, so a failure message leaving Core is made one line by the same rule as a trust
         reason leaving this package. -->
    <InternalsVisibleTo Include="Tessio.Verifier.Core" />
    <InternalsVisibleTo Include="Tessio.Verifier.Trust.Tests" />
  </ItemGroup>

</Project>
