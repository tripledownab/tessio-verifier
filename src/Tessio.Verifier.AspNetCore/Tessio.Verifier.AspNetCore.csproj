<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- The resolved package graph, transitive packages included, is committed as packages.lock.json
         beside this file, inside src/, so the conformance record's src tree covers it. CI restores in
         locked mode, so a bump that did not regenerate the lock file fails. It guards against
         accidents, not deliberate edits; see tools/check-conformance-record.py. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Tessio.Verifier.OpenId4Vp\Tessio.Verifier.OpenId4Vp.csproj" />
    <ProjectReference Include="..\Tessio.Verifier.Core.Mdoc\Tessio.Verifier.Core.Mdoc.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- QR rendering for the built-in start page (SVG renderer, cross-platform). MIT, no transitive deps. -->
    <PackageReference Include="QRCoder" Version="1.8.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- The hosted pages' markup, styles and scripts, kept as files so tools read them as what they are.
         The logical name is fixed here because HostedPageAssets reads them by it. -->
    <EmbeddedResource Include="PageAssets\*" LogicalName="Tessio.Verifier.AspNetCore.PageAssets.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Tessio.Verifier.AspNetCore.Tests" />
    <!-- The browser test's host answers requests as a wallet would, with the mock issuer. -->
    <InternalsVisibleTo Include="Tessio.Verifier.BrowserTestHost" />
  </ItemGroup>

</Project>
