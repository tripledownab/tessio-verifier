<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Tessio.Verifier.Trust\Tessio.Verifier.Trust.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.23.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Tessio.Verifier.Core.Tests" />
    <!-- For CompactJwt, which the wallet response parser needs and no consumer of this package does.
         Mirrors the grant Tessio.Verifier.OpenId4Vp already makes to Tessio.Verifier.AspNetCore. -->
    <InternalsVisibleTo Include="Tessio.Verifier.OpenId4Vp" />
    <!-- For TrustSeam, so both credential verifiers turn a failing trust source into the same result. -->
    <InternalsVisibleTo Include="Tessio.Verifier.Core.Mdoc" />
  </ItemGroup>

  <PropertyGroup>
    <!-- The resolved package graph, transitive packages included, is committed as packages.lock.json
         beside this file, inside src/, so the conformance record's src tree covers it. CI restores in
         locked mode, so a bump that did not regenerate the lock file fails. It guards against
         accidents, not deliberate edits; see tools/check-conformance-record.py. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
